{
  "name": "subbridge",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first AI gateway for Codex CLI and Ollama.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch src/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && vite build",
    "start": "node dist/index.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "fastify": "^5.2.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
